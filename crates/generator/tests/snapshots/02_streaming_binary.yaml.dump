openapi 3.1 (3.1.0)
root-servers:
  - url `https://{region}.api.example.com/v1`
    variable `region` default=`us-east` enum=[us-east|eu-west]
schemas:
  ProblemDetails -> type `ProblemDetails` (#0):
    nullable=false
    plain
operations:
  put /objects/{id}:
    method-name: put_object
    response-enum: PutObjectResponse
    operation-id: putObject
    effective-servers:
      - url `https://{region}.api.example.com/v1`
        variable `region` default=`us-east` enum=[us-east|eu-west]
    parameters:
      - in=path name=`id` required=true style=Simple explode=false allow-reserved=false origin=PathLevel
    request-body: required=true
      content:
        - `application/octet-stream` class=binary schema=#3
    responses:
      - status 201
      - status 400
        content:
          - `application/problem+json` class=json schema=#4
  get /objects/{id}:
    method-name: get_object
    response-enum: GetObjectResponse
    operation-id: getObject
    effective-servers:
      - url `/storage`
    parameters:
      - in=path name=`id` required=true style=Simple explode=false allow-reserved=false origin=PathLevel
    request-body: (absent)
    responses:
      - status 200
        header `ETag` required=false nullable=false required-flag=false
        header `Content-Length` required=false nullable=false required-flag=false
        content:
          - `application/octet-stream` class=binary schema=#7
      - status 404
        content:
          - `application/problem+json` class=json schema=#8
arena:
  #0 object props=1 additional=ignore
    property `title` required=true -> #1
    resolved:
      nullable=false
      plain
  #1 string
    resolved:
      nullable=false
      plain
  #2 string
    resolved:
      nullable=false
      plain
  #3 string:binary BINARY
    resolved:
      nullable=false
      plain
  #4 ref->#0
    resolved:
      nullable=false
      alias -> #0
  #5 string
    resolved:
      nullable=false
      plain
  #6 integer:int64
    resolved:
      nullable=false
      plain
  #7 string:binary BINARY
    resolved:
      nullable=false
      plain
  #8 ref->#0
    resolved:
      nullable=false
      alias -> #0
diagnostics:
  (none)
